#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
project-brain-reset — delete the local files of a project brain

Usage:
  project-brain-reset [path] [options]

Arguments:
  path        Project root directory (default: current directory)

Options:
  --dry-run   Preview what would be deleted (default behavior)
  --confirm   Execute deletion (irreversible)
  --help      Show this message

What gets deleted:
  - .brain/ directory (wiki, state, logs, raw refs)
  - graphify-out/ directory (dependency graph)
  - the "# Project Brain" block in root CLAUDE.md
  - CLAUDE.project-brain.snippet.md

What is NEVER deleted:
  - Your project source code
  - MemPalace drawers (the /project-brain:reset skill deletes those via MCP)

You can start fresh immediately with project-brain-init.
EOF
}

if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
PYTHON_BIN="${PYTHON_BIN:-python3}"
exec "$PYTHON_BIN" -S "$ROOT/scripts/reset_brain.py" "$@"